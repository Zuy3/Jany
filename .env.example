# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# LEADS_WEBHOOK_URL: Optional external webhook (e.g., Zapier, Make, ActiveCampaign, Hotmart, n8n)
# When set, all validated leads will be forwarded via POST securely by the server.
LEADS_WEBHOOK_URL=""

